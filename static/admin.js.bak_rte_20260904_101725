  } catch (e) {
    box.innerHTML = `<span class="text-danger">自检失败：${escHtml(e.message)}</span>`;
  }
});

function escHtml(s) {
  return String(s === undefined || s === null ? '' : s).replace(/[&<>"']/g, ch => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  })[ch]);
}

