function uploadQr(id) {
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = 'image/*';
  input.onchange = async () => {
    const f = input.files[0];
    if (!f) return;
    const fd = new FormData();
    fd.append('file', f);
    try {
      await api('/api/contacts/' + id + '/qr', { method: 'POST', body: fd });
      loadContacts();
    } catch (e) { alert(e.message); }
  };
  input.click();
}

