function viewVersion(id) {
  api('/api/versions/' + id).then(v => {
    const s = v.snapshot || {};
    const secs = (s.sections || []).map(x => `${x.section_type}${x.enabled ? '' : '(停)'}`).join(', ') || '无';
    const pgs = (s.pages || []).map(x => x.slug).join(', ') || '无';
    const prds = (s.products || []).length;
    const cfg = s.config || {};
    const seoT = cfg.seo_site_title || '（未设置）';
    alert(`版本 #${v.id}  ${v.created_at}\n模板: ${v.template}\n备注: ${v.note}\n\n【板块】${secs}\n\n【自定义页面】${pgs}\n\n【产品】${prds} 个\n\n【SEO 标题】${seoT}\n\n快照已包含：板块/自定义页面/友情链接/产品/公司联系方式/横幅/Logo/素材清单/站点配置。恢复需重新部署上线。`);
  }).catch(e => alert(e.message));
}

function restoreVersion(id) {
  // 恢复属于高影响操作：先查出版本信息，弹强确认，确认后才真正调恢复接口
  api('/api/versions/' + id).then(v => {
    const s = v.snapshot || {};
    const secs = (s.sections || []).length || 0;
    const pgs = (s.pages || []).length || 0;
    const prds = (s.products || []).length || 0;
    $('restoreVersionInfo').innerHTML =
      `<p class="mb-1">版本 #${v.id} · ${esc(v.created_at)} · 模板：${esc(v.template)}</p>
       <div class="small text-secondary">包含：${secs} 个板块 / ${pgs} 个自定义页面 / ${prds} 个产品 / 友链、联系方式、横幅、Logo、素材、站点配置等全部可管理内容</div>`;
    if (window.restoreModal) {
      restoreModal.show();
      window.__restoreTargetId = id;
    }
  }).catch(e => alert(e.message));
}

async function confirmRestoreVersion() {
  const id = window.__restoreTargetId;
  if (!id) return;
  const btn = $('restoreConfirmBtn');
  const old = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>恢复中...';
  try {
    await api('/api/versions/' + id + '/restore', { method: 'POST' });
    if (restoreModal) restoreModal.hide();
    alert('已恢复到版本 #' + id + '。当前所有内容已被该版本完整覆盖。\n\n请点击顶部「🚀 一键生成并上传」，将恢复后的内容重新生成并部署到线上站点。');
    loadConfig();
    loadTemplates();
    loadSiteLayouts();
    loadBanners();
    loadContacts();
    loadProducts();
    loadSections();
    loadPages();
    loadFriendLinks();
    loadVersions();
    loadStats();
  } catch (e) {
    alert(e.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = old;
  }
}


